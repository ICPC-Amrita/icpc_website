generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id          String   @id @default(uuid())
  personName  String?
  userEmail   String?
  isVerified  Boolean  @default(false)
  campus      String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String
}
